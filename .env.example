# Copy to .env and change the passwords. .env is gitignored.
# Compose reads this file for the datastore services; the API reads it too.

APP_ENV=local
LOG_LEVEL=INFO

# --- Postgres (ledger, source of truth for money) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=sentinelpay
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis (velocity windows) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- MongoDB (audit log) ---
MONGO_USER=sentinel
MONGO_PASSWORD=local-dev-only-change-me
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=sentinelpay
MONGO_URL=mongodb://sentinel:local-dev-only-change-me@127.0.0.1:27017/?authSource=admin

# --- API auth (dev only; Phase 5 replaces this with real tokens) ---
API_KEY_DEV=sk_local_dev_key
ANALYST_TOKEN=analyst_local_dev_token

# --- Risk engine (Phase 2) ---
RISK_APPROVE_MAX=0.45
RISK_REVIEW_MAX=0.75
RISK_MODEL_PATH=backend/ml/artifacts/model.joblib
RISK_MODEL_META_PATH=backend/ml/artifacts/model_meta.json
RISK_DEGRADED_REVIEW_FLOOR_MINOR=10000

# --- RAG copilot (Phase 4) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_SECONDS=60
CHROMA_PATH=backend/.chroma
